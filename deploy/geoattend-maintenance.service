[Unit]
Description=GeoAttend independent reconciliation and retention worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=geoattend
Group=geoattend
WorkingDirectory=/opt/geoattend/current
EnvironmentFile=/etc/geoattend/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/geoattend/venv/bin/python -u -c "import json,logging.config; from scripts.maintenance import main; logging.config.dictConfig(json.load(open('deploy/logging.json'))); main()"
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
