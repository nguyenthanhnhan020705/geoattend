GEOATTEND_DATABASE_URL=postgresql://runtime:CHANGE_ME@localhost:5432/geoattend
GEOATTEND_MIGRATION_DATABASE_URL=postgresql://migration:CHANGE_ME@localhost:5432/geoattend
GEOATTEND_TEST_DATABASE_URL=postgresql://test:CHANGE_ME@localhost:5432/geoattend_test
GEOATTEND_ORIGIN=http://127.0.0.1:8000
GEOATTEND_SECURE_COOKIES=false
GEOATTEND_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOATTEND_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Optional: local_run with Supabase session pooler. Remove placeholder
# GEOATTEND_DATABASE_URL / GEOATTEND_MIGRATION_DATABASE_URL above to use these.
# SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.PROJECT_REF
# SUPABASE_DB_PASSWORD=CHANGE_ME
# SUPABASE_DB_SSLMODE=require
# GEOATTEND_RUNTIME_DB_USER=geoattend_runtime.PROJECT_REF
# GEOATTEND_RUNTIME_DB_PASSWORD=CHANGE_ME
